---
import SiteLayout from "../layouts/SiteLayout.astro";
import BulletinHome from "../components/BulletinHome.astro";
import StoryCard from "../components/StoryCard.astro";
import { themeTemplate } from "../lib/theme-registry.mjs";
import { config, getCategories, getPages, getPosts, plainText, sitePath } from "../lib/dashless.mjs";

const [posts, pages, categories] = await Promise.all([getPosts(), getPages(), getCategories()]);
const [lead, ...remaining] = posts.slice(0, 10);
const homePage = pages.find((page: any) => page.isHome);
const template = themeTemplate(config.design);
---

<SiteLayout digest={homePage?.digest}>
  {template === "bulletin" ? <BulletinHome posts={posts} categories={categories}/> : <>
  <section class="hero retro-window">
    <div class="window-bar"><span>Home</span><span aria-hidden="true">— □ ×</span></div>
    <div class="hero-copy">
      <p class="online-status"><span aria-hidden="true"></span> TRANSMITTING FROM THE WEIRD LITTLE WEB</p>
      <h1>{homePage?.title || config.siteName}</h1>
      <p>{homePage ? plainText(homePage.excerpt || homePage.content).slice(0, 220) : config.siteDescription}</p>
      <div class="hero-badges" aria-label="Site features"><span>INDEPENDENT SITE</span><span>NO ALGORITHM</span><span>SLIGHTLY HAUNTED</span></div>
    </div>
    <div class="hero-sticker" aria-hidden="true"><span>LOOK!</span><strong>CERTIFIED<br />STRANGE<br />SIGNAL</strong><small>EST. {new Date().getFullYear()}</small></div>
  </section>
  {homePage?.content && <section class="home-content paper-panel article-body" set:html={homePage.content} />}
  {lead ? (
    <div class="home-layout">
      <section class="post-stream">
        <div class="section-heading"><div><span aria-hidden="true">✦</span><h2>Latest stories</h2></div><p>Sorted newest to oldest, just like nature intended.</p></div>
        <StoryCard story={lead} featured />
        {remaining.length > 0 && <div class="story-grid">{remaining.map((story: any) => <StoryCard story={story} />)}</div>}
        <p class="archive-link"><a href={sitePath(`/${config.postsPath}/`)}>OPEN THE COMPLETE ARCHIVE <span aria-hidden="true">→</span></a></p>
      </section>
      <aside class="blog-sidebar" aria-label="Site extras">
        <section class="sidebar-widget currently-widget">
          <div class="widget-title">AT A GLANCE</div>
          <dl><div><dt>Stories</dt><dd>{posts.length}</dd></div><div><dt>Topics</dt><dd>{categories.length}</dd></div></dl>
        </section>
        <section class="sidebar-widget">
          <div class="widget-title">BROWSE TOPICS</div>
          <div class="topic-buttons">{categories.slice(0, 8).map((term: any) => <a href={term.url}><span>{term.name}</span><small>{term.count}</small></a>)}</div>
        </section>
        <section class="sidebar-widget guestbook-widget">
          <div class="widget-title">DON'T MISS A POST</div>
          <p>RSS: the original follow button. Quiet, chronological, perfect.</p>
          <a class="chunky-button" href={sitePath("/rss.xml")}>ADD TO READER ↗</a>
        </section>
      </aside>
    </div>
  ) : (
    <section class="empty-state retro-window"><div class="window-bar"><span>Stories</span><span>×</span></div><h2>No published stories yet.</h2><p>New stories will appear here when they are published.</p></section>
  )}
</>}
</SiteLayout>
