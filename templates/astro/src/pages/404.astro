---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../lib/dashless.mjs";
---

<SiteLayout title="Page not found" description="This page could not be found." noindex>
  <section class="empty-state retro-window error-window">
    <div class="window-bar"><span>Page not found</span><span aria-hidden="true">×</span></div>
    <p class="eyebrow">PAGE NOT FOUND</p>
    <h1>Oops! This link fell off the internet.</h1>
    <p>The address may have moved, disappeared, or returned to the mysterious void from which all broken links emerge.</p>
    <p><a class="chunky-button" href={sitePath("/")}>RETURN HOME</a></p>
  </section>
</SiteLayout>
