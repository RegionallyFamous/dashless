---
import { config, sitePath } from '../lib/dashless.mjs';
import PublicationHero from './PublicationHero.astro';
import LeadStory from './LeadStory.astro';
import StoryCollection from './StoryCollection.astro';
const { posts, categories } = Astro.props;
const lead = posts.find((p:any) => p.featuredImage) || posts[0];
const rest = posts.filter((p:any) => p.id !== lead?.id).slice(0,8);
const department = new URL(config.publicUrl).hostname === 'smallproblems.dashless.blog';
const themeId = String((config.design as any)?.theme_id || 'bulletin');
---

<div class:list={["publication-home", `publication-home--${themeId}`]} data-theme-home={themeId}>
<PublicationHero themeId={themeId} department={department} />
{lead ? <>
<LeadStory story={lead} themeId={themeId} />
<StoryCollection stories={rest} themeId={themeId}>
  <a slot="action" href={sitePath(`/${config.postsPath}/`)}>All stories ↗</a>
</StoryCollection>
</> : <section class="empty-state"><h2>No published stories yet.</h2><p>New stories will appear here when they are published.</p></section>}
{categories.length>0 && <section class="bulletin-departments" aria-label="Browse topics"><p class="eyebrow">CHOOSE YOUR DEPARTMENT</p><div>{categories.map((t:any)=><a href={t.url}>{t.name}<span aria-hidden="true">↗</span></a>)}</div></section>}
<section class="bulletin-follow"><div><p class="eyebrow">THE NEXT SMALL THING</p><h2>Stay curious.</h2><p>Follow every new dispatch in your favorite RSS reader.</p></div><a class="bulletin-read" href={sitePath("/rss.xml")}>Follow the bulletin <span aria-hidden="true">↗</span></a></section>
</div>
