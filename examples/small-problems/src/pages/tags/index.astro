---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { config, getTags } from "../../lib/dashless.mjs";
const terms = await getTags();
---

<SiteLayout title="Tags" description={`Browse ${config.siteName} stories by tag.`}>
  <header class="archive-header retro-window"><div class="window-bar"><span>Index</span><span aria-hidden="true">— □ ×</span></div><div><p class="eyebrow">CROSS-REFERENCED, MORE OR LESS</p><h1>Tags</h1><p>Evidence, open inquiries, and updates that resolve almost nothing.</p></div></header>
  <div class="term-cloud">{terms.map((term: any) => <a href={term.url}><strong>{term.name}</strong><span>{term.count}</span></a>)}</div>
</SiteLayout>
