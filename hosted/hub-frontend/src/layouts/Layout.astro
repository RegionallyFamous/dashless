---
import rip from '../assets/rip.svg';
import hotType from '../assets/hot-type-v3.webp';
import night from '../assets/studio-minimal-night-hd.webp';
import '../styles/site.css';

const { title, description = 'A small publishing studio for a kinder internet.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={rip.src} />
    <link rel="canonical" href={`https://dashless.blog${Astro.url.pathname}`} />
    <title>{title} · Dashless</title>
  </head>
  <body class="wp-site-blocks">
    <header class="dl-masthead" aria-label="Dashless header">
      <p class="dl-wordmark">
        <a href="/" aria-label="Dashless home">
          <img class="dl-rip" src={rip.src} alt="" width="52" height="52" />
          <span class="dl-hot-type" role="img" aria-label="Dashless" style={`--hot-type-url: url(${hotType.src})`}></span>
        </a>
      </p>
      <nav class="dl-nav" aria-label="Primary navigation">
        <p><a href="/#how-it-works">How it works</a></p>
        <p><a href="/themes/">Themes</a></p>
        <p><a href="/#account">Your account</a></p>
      </nav>
    </header>
    <main class="dl-main"><slot /></main>
    <footer class="dl-footer dl-studio-footer">
      <div class="dl-footer-invitation"><p>A small place<br />for big ideas.</p><small>DIFFERENT IS A FEATURE.</small></div>
      <div class="dl-footer-story"><figure><img src={night.src} alt="A warmly lit neighborhood bookshop at night" width="1254" height="1254" /><figcaption>Keep making room.</figcaption></figure><p>Same streets.<br />New stories. ☾</p></div>
      <div class="dl-footer-help"><nav aria-label="Footer navigation"><a href="/#pricing">Pricing</a><a href="/account/">Account</a><a href="/wp-login.php">WordPress sign in</a></nav><p>See you<br />out there. ↗</p></div>
      <small class="dl-footer-credit">Dashless · a small publishing studio for a kinder internet.</small>
    </footer>
  </body>
</html>
