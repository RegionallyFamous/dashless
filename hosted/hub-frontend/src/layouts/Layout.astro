---
const { title, description = 'A small publishing studio for a kinder internet.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://dashless.blog${Astro.url.pathname}`} />
    <title>{title} · Dashless</title>
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Dashless home">dashless<span>↗</span></a>
      <nav aria-label="Primary navigation">
        <a href="/#how-it-works">How it works</a>
        <a href="/#pricing">Pricing</a>
        <a href="/account/">Your account</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>Different is a feature.</p>
      <nav aria-label="Footer navigation">
        <a href="/account/">Account</a>
        <a href="/wp-login.php">WordPress sign in</a>
      </nav>
      <small>Dashless · a small publishing studio for a kinder internet.</small>
    </footer>
  </body>
</html>
<style is:global>
  :root{font-family:Arial,Helvetica,sans-serif;color:#201f22;background:#f7f2e8;line-height:1.45}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0}a{color:inherit}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #3858e9;outline-offset:4px}.masthead,main,footer{max-width:1240px;margin:auto}.masthead{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 24px 18px;border-bottom:2px solid #201f22}.wordmark{font:bold 27px/1 Georgia,serif;letter-spacing:-.07em;text-decoration:none}.wordmark span{display:inline-block;margin-left:7px;font:18px/1 Arial;transform:rotate(-8deg)}nav{display:flex;flex-wrap:wrap;gap:24px;font-size:13px;font-weight:600}nav a{text-decoration:none}nav a:hover{text-decoration:underline;text-underline-offset:5px}main{padding:0 24px}footer{display:flex;flex-wrap:wrap;align-items:center;gap:20px;padding:24px;border-top:2px solid #201f22}footer p{font:26px/1 Georgia,serif;margin:0}footer nav{margin-left:auto;font-weight:400}footer small{flex-basis:100%;font:11px/1.4 ui-monospace,monospace;color:#625d68}
  .eyebrow,.kicker{font:11px/1.5 ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;background:#dfff00;border:2px solid #201f22;box-shadow:4px 4px 0 #201f22;font-weight:700;text-decoration:none;cursor:pointer}.button:hover{transform:translateY(-2px)}.button.secondary{background:transparent;box-shadow:none}.fine{font-size:12px;color:#625d68}.panel{border:1px solid #aaa399;background:#fbf6eb;padding:clamp(22px,4vw,48px);box-shadow:3px 4px 0 #201f2220}
  @media(max-width:680px){.masthead{display:block;padding:16px 20px}.masthead nav{justify-content:space-between;gap:12px;margin-top:18px;font-size:12px}main{padding:0 20px}footer{padding:20px}footer nav{margin-left:0;width:100%;justify-content:space-between}}
</style>
