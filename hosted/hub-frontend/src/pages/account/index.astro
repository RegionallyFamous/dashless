---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Your account" description="Manage your Dashless account, blog, domain, and subscription.">
  <section class="account-shell" aria-labelledby="account-title">
    <p class="eyebrow">Your Dashless account</p>
    <h1 id="account-title">Your corner<br />of the web.</h1>
    <div id="account-root" class="panel" data-api="/wp-json/dashless-hub/v1/" data-nonce="/wp-json/dashless/v1/nonce"><p>Checking your account…</p></div>
  </section>
</Layout>
<script>
  const root = document.querySelector('#account-root');
  const api = root?.dataset.api || '/wp-json/dashless-hub/v1/';
  const login = () => { location.href = `/auth/login?return=${encodeURIComponent('/account/')}`; };
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const request = async (path, options = {}) => { const response = await fetch(api + path.replace(/^\//, ''), { credentials: 'same-origin', headers: {'Accept':'application/json', ...(options.headers || {})}, ...options }); if (response.status === 401 || response.status === 403) throw new Error('auth'); const body = await response.json(); if (!response.ok) throw new Error(body.message || body.error || 'Request failed'); return body; };
  const action = async (path, body = {}) => { const nonce = await fetch('/wp-json/dashless/v1/nonce', {credentials:'same-origin'}).then((response) => response.ok ? response.json() : null); return request(path, {method:'POST', headers:{'Content-Type':'application/json','X-WP-Nonce':nonce?.nonce || ''}, body:JSON.stringify(body)}); };
  const render = (account) => { const ready = account.state === 'ready'; const signedIn = account && account.state; root.innerHTML = signedIn ? `<div class="account-heading"><p>${ready ? 'Your blog is live and verified.' : 'Your account is ready.'}</p><a href="${esc(account.logout_url || '/account/')}">Sign out</a></div><h2>${esc(account.site_url || 'Give your blog a home.')}</h2><p>${esc(account.message || (ready ? 'Your latest release passed its public check and is serving readers.' : 'We’ll keep your setup progress here.'))}</p>${ready ? `<div class="cards"><div><small>Your blog</small><h3>${esc(account.site_url)}</h3><a class="button" href="${esc(account.site_url)}" target="_blank" rel="noopener">Visit your blog ↗</a></div><div><small>Publication health</small><h3><span class="dot"></span> Live and verified</h3><p class="fine">Release ${esc(account.release?.id || '—')}</p></div></div>` : `<form id="checkout"><label for="slug">Choose your address</label><div class="address"><input id="slug" name="slug" value="${esc(account.slug || '')}" pattern="[a-z][a-z0-9-]{1,38}[a-z0-9]" minlength="3" maxlength="40" required /><span>.dashless.blog</span></div><button class="button" type="submit">Continue to secure checkout →</button><p id="status" class="fine"></p></form>`}<div id="account-status" class="fine" role="status"></div>` : `<h2>Your corner of the web.</h2><p>Sign in to set up your blog, connect ChatGPT, or manage your subscription.</p><button class="button" id="sign-in">Sign in →</button>`; document.querySelector('#sign-in')?.addEventListener('click', login); document.querySelector('#checkout')?.addEventListener('submit', async (event) => { event.preventDefault(); const status = document.querySelector('#status'); status.textContent = 'Opening secure checkout…'; try { const result = await action('checkout', {slug: new FormData(event.currentTarget).get('slug')}); if (result.url) location.href = result.url; else status.textContent = 'Checkout is not available yet.'; } catch (error) { status.textContent = error.message === 'auth' ? 'Please sign in again.' : error.message; }}); };
  request('account').then(render).catch((error) => error.message === 'auth' ? render({}) : (root.innerHTML = '<p>We could not load your account. Please try again.</p><button class="button" id="retry">Try again</button>', document.querySelector('#retry')?.addEventListener('click', () => location.reload())));
</script>
<style>
  .account-shell{padding:clamp(58px,9vw,110px) 0 100px;max-width:900px;margin:auto}.account-shell h1{font:900 clamp(52px,7vw,92px)/.92 Arial,sans-serif;letter-spacing:-.075em;margin:16px 0 38px}.account-heading{display:flex;justify-content:space-between;gap:20px;align-items:start;border-bottom:1px solid #aaa399;padding-bottom:18px}.account-heading p{margin:0;font:21px Georgia,serif}.account-heading a{font-size:13px}.panel h2{font:400 clamp(29px,4vw,48px)/1 Georgia,serif;letter-spacing:-.05em;margin:24px 0 12px}.panel>p{font:18px/1.5 Georgia,serif}.panel form{margin-top:32px;max-width:570px}.panel label{display:block;font-weight:700;margin-bottom:8px}.address{display:flex;align-items:center;gap:8px;margin-bottom:18px}.address input{min-width:0;flex:1;border:1px solid #6d6870;background:#fffdf8;padding:13px;font:16px Arial}.address span{font:16px Georgia,serif;white-space:nowrap}.cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px}.cards>div{border:1px solid #aaa399;padding:20px;background:#f7f2e8}.cards small{font:11px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.08em}.cards h3{font:21px Georgia,serif;margin:12px 0 20px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#6e9950;margin-right:7px}.fine{font-size:12px!important;color:#625d68}.button{font-size:14px}.panel button{font:700 14px Arial}@media(max-width:640px){.cards{grid-template-columns:1fr}.account-heading{display:block}.account-heading a{display:inline-block;margin-top:12px}.address{display:block}.address span{display:block;margin-top:7px}}
</style>
