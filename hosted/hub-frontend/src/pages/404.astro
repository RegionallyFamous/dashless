---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="not-found">
    <p class="eyebrow">404 · A little detour</p>
    <h1>That page wandered off.</h1>
    <p>Try heading back to the Dashless home page.</p>
    <a class="button" href="/">Return home →</a>
  </section>
</Layout>
<style>.not-found{padding:120px 0;max-width:680px}.not-found h1{font:900 clamp(48px,7vw,86px)/.95 Arial,sans-serif;letter-spacing:-.07em;margin:18px 0}.not-found p:not(.eyebrow){font:20px Georgia,serif;margin-bottom:28px}</style>
