    },
    "scope": "blog:read"
  },
  {
    "name": "create_draft",
    "title": "Create a WordPress draft",
    "description": "Create a core post or page with status draft only after an explicit editorial request. Never use this tool to populate a design, preview, deployment, or launch. client_key makes retries idempotent and must remain stable for the same intended item.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "post_type": {
          "type": "string",
          "enum": [
            "post",
            "page"
          ],
          "description": "WordPress core post type."
        },
        "client_key": {
          "type": "string",
          "minLength": 8,
          "description": "Stable UUID-like key for this intended draft."
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "Portable semantic HTML."
        },
        "excerpt": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "featured_media": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "parent": {
          "type": "integer",
          "minimum": 0,
          "description": "Parent Page ID. Used only for pages."
        },
        "menu_order": {
          "type": "integer",
          "description": "Page navigation order. Used only for pages."
        }
      },
      "additionalProperties": false,
      "required": [
        "post_type",
        "client_key",
        "title",
        "content"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "scope": "blog:write"
  },
